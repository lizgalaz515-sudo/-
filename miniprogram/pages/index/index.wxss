page{
  background:#f7f7fb;
  color:#272435;
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size:14px;
  line-height:1.5
}
view,button,input,textarea{
  box-sizing:border-box
}
button{
  margin:0;
  padding:0;
  border:0;
  border-radius:0;
  background:transparent;
  color:inherit;
  font-family:inherit;
  font-size:inherit;
  line-height:inherit;
  text-align:left;
  overflow:visible
}
button::after{
  border:0
}
button[disabled]{
  background:transparent;
  color:#aca9bb
}
text{
  white-space:normal
}
.icon{
  display:block;
  width:21px;
  height:21px;
  flex-shrink:0
}
.tiny-icon{
  display:block;
  width:15px;
  height:15px;
  flex-shrink:0
}
.large-icon{
  width:31px;
  height:31px
}
.app-shell{
  min-height:100vh
}
.sidebar{
  display:none
}
.workspace{
  padding:0 20px 94px;
  max-width:1260px;
  margin:0 auto
}
.topbar{
  height:83px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-bottom:1px solid #eae9f1
}
.mobile-brand{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:23px;
  font-weight:750;
  letter-spacing:1px
}
.brand-mark{
  width:36px;
  height:36px;
  border-radius:11px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#7c5ce7;
  box-shadow:0 5px 12px #7c5ce722
}
.brand-icon{
  width:23px;
  height:23px
}
.topbar-right{
  display:flex;
  align-items:center;
  gap:13px
}
.demo-pill,.local-pill{
  display:flex;
  align-items:center;
  gap:6px;
  font-size:11px;
  line-height:1;
  padding:8px 10px;
  border-radius:7px;
  background:#ede9fa;
  color:#8063cd;
  white-space:nowrap;
  font-weight:550
}
.local-pill{
  background:#eef5f1;
  color:#648a76
}
.demo-dot,.save-dot{
  width:5px;
  height:5px;
  border-radius:50%;
  background:#9578e4;
  flex-shrink:0
}
.save-dot{
  background:#84aa95
}
.avatar{
  width:34px;
  height:34px;
  border-radius:50%;
  background:#eeecf5;
  display:flex;
  align-items:center;
  justify-content:center
}
.avatar .icon{
  width:19px;
  height:19px
}
.desktop-heading{
  display:none
}
.page-content{
  padding-top:25px
}
.greeting-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:14px;
  margin-bottom:23px
}
.eyebrow{
  display:block;
  color:#9995aa;
  font-size:10px;
  letter-spacing:1.2px;
  font-weight:600;
  margin-bottom:7px
}
.greeting-title{
  display:block;
  font-weight:720;
  font-size:23px;
  letter-spacing:-.5px;
  color:#272435
}
.small-streak{
  display:none
}
.hero-card{
  position:relative;
  min-height:253px;
  border-radius:19px;
  background:linear-gradient(118deg,#ede8fb 0%,#eee9fc 42%,#e6ddfa 100%);
  padding:26px 23px;
  overflow:hidden;
  margin-bottom:20px
}
.hero-copy{
  position:relative;
  z-index:2
}
.hero-kicker{
  display:flex;
  gap:7px;
  align-items:center;
  font-size:8px;
  letter-spacing:2px;
  color:#9277c4;
  font-weight:650;
  margin-bottom:16px
}
.hero-kicker-line{
  width:16px;
  height:1px;
  background:#a891ce
}
.hero-title{
  display:block;
  white-space:pre-line;
  font-size:27px;
  line-height:1.48;
  letter-spacing:.2px;
  font-weight:750;
  color:#3a2c58
}
.hero-sub{
  display:block;
  color:#8c7ea4;
  font-size:10px;
  margin-top:10px;
  max-width:200px
}
.app-shell .hero-button{
  display:flex;
  align-items:center;
  gap:8px;
  background:#7c5ce7;
  color:#fff;
  border-radius:9px;
  padding:11px 13px;
  font-size:12px;
  font-weight:600;
  width:177px;
  margin-top:21px;
  box-shadow:0 7px 15px #7c5ce725
}
.app-shell .hero-button .icon{
  width:16px;
  height:16px
}
.button-arrow{
  margin-left:auto;
  font-size:18px;
  font-weight:400;
  line-height:1
}
.hero-art{
  position:absolute;
  right:-52px;
  top:10px;
  width:230px;
  height:220px;
  opacity:.7
}
.art-orbit{
  position:absolute;
  border:1px solid #d6c8ef;
  border-radius:50%;
  transform:rotate(-28deg)
}
.orbit-one{
  width:215px;
  height:145px;
  top:35px;
  left:20px
}
.orbit-two{
  width:190px;
  height:195px;
  top:15px;
  left:15px
}
.art-star{
  position:absolute;
  color:#ab94d7;
  line-height:1
}
.star-one{
  font-size:25px;
  left:45px;
  top:29px
}
.star-two{
  font-size:18px;
  right:7px;
  bottom:25px
}
.dumbbell{
  position:absolute;
  width:200px;
  height:130px;
  transform:rotate(-28deg);
  left:16px;
  top:54px;
  filter:drop-shadow(4px 11px 9px #8465bc24)
}
.dumbbell-bar{
  position:absolute;
  background:linear-gradient(#d9ccf3,#c4b0e4 40%,#b7a0db 70%,#d7c5ef);
  height:23px;
  width:173px;
  left:12px;
  top:55px;
  border-radius:7px;
  box-shadow:inset 0 2px 1px #f9f5ff99
}
.weight{
  position:absolute;
  background:linear-gradient(110deg,#d1c0ef,#b499df 45%,#a084d0);
  border:1px solid #c1a8e7;
  border-radius:10px;
  box-shadow:inset 3px 2px 4px #e3d5f780,inset -5px -2px 6px #8868b440
}
.weight-left-outer{
  width:26px;
  height:75px;
  top:29px;
  left:15px;
  z-index:2
}
.weight-left-inner{
  width:37px;
  height:112px;
  top:10px;
  left:40px;
  background:linear-gradient(105deg,#d4c2f1,#b297df 62%,#ac8fd7);
  z-index:3
}
.weight-right-inner{
  width:37px;
  height:112px;
  top:10px;
  right:37px;
  z-index:2
}
.weight-right-outer{
  width:25px;
  height:75px;
  top:29px;
  right:14px;
  z-index:3
}
.art-caption{
  position:absolute;
  bottom:2px;
  left:61px;
  display:flex;
  align-items:center;
  gap:5px;
  font-size:6px;
  letter-spacing:1.4px;
  color:#ab99c7
}
.art-caption .save-dot{
  background:#a38ac4;
  width:4px;
  height:4px
}
.stats-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:9px;
  margin-bottom:20px
}
.stat-card{
  background:#fff;
  padding:13px 12px 14px;
  border:1px solid #eeedf5;
  border-radius:13px;
  min-width:0
}
.stat-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:5px;
  font-size:10px;
  color:#8a859c;
  white-space:nowrap
}
.stat-icon{
  display:none
}
.stat-value{
  font-size:25px;
  line-height:1.25;
  font-weight:750;
  letter-spacing:-.7px;
  color:#2e2a3f;
  margin-top:13px;
  white-space:nowrap
}
.stat-unit{
  font-size:10px;
  font-weight:400;
  color:#9891a8;
  margin-left:4px;
  letter-spacing:0
}
.stat-caption{
  display:block;
  font-size:9px;
  color:#aaa5b8;
  margin-top:7px;
  line-height:1.6;
  min-height:27px
}
.stat-label{
  color:#8a859c;
  font-size:11px
}
.dashboard-grid{
  display:flex;
  flex-direction:column;
  gap:18px
}
.main-column,.side-column{
  display:flex;
  flex-direction:column;
  gap:18px;
  min-width:0
}
.content-card{
  background:#fff;
  border:1px solid #eeedf5;
  border-radius:16px;
  padding:20px
}
.section-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:21px
}
.section-title{
  display:block;
  font-size:16px;
  font-weight:680;
  letter-spacing:-.3px
}
.section-subtitle{
  display:block;
  font-size:10px;
  color:#a09bad;
  margin-top:5px;
  line-height:1.7
}
.app-shell .text-button{
  color:#8b79bb;
  font-size:10px;
  display:flex;
  align-items:center;
  gap:5px;
  white-space:nowrap
}
.app-shell .text-button text{
  font-size:14px
}
.week-days{
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
  gap:4px
}
.app-shell .week-day{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
  border-radius:11px;
  padding:8px 0;
  min-width:0
}
.week-label{
  font-size:10px;
  color:#a09aad
}
.week-date{
  position:relative;
  width:31px;
  height:31px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:12px;
  font-weight:600;
  color:#757086
}
.week-done{
  background:#f0ebfd;
  color:#8b6cd2
}
.app-shell .week-today{
  background:#f5f2fc
}
.app-shell .week-today .week-date{
  background:#7c5ce7;
  color:#fff;
  box-shadow:0 4px 8px #7c5ce724
}
.app-shell .week-today .week-label{
  color:#8971bd
}
.week-check{
  position:absolute;
  bottom:-2px;
  right:-2px;
  background:#fff;
  color:#9f85d2;
  border:1px solid #e7def7;
  border-radius:50%;
  font-size:7px;
  height:12px;
  width:12px;
  display:flex;
  align-items:center;
  justify-content:center
}
.week-indicator{
  width:3px;
  height:3px;
  border-radius:50%;
  background:#e9e7f0
}
.indicator-done{
  background:#b09ad8
}
.week-footer{
  display:flex;
  align-items:center;
  gap:6px;
  border-top:1px solid #f0edf5;
  margin-top:16px;
  padding-top:14px;
  font-size:9px;
  color:#aaa4b7
}
.week-footer .save-dot{
  background:#b29dd8;
  width:4px;
  height:4px
}
.recent-card .section-header{
  margin-bottom:10px
}
.workout-row{
  display:flex;
  align-items:center;
  gap:11px;
  width:100%;
  padding:15px 0;
  border-bottom:1px solid #f2eff7
}
.workout-row:last-child{
  border-bottom:0;
  padding-bottom:1px
}
.workout-symbol{
  width:39px;
  height:39px;
  border-radius:12px;
  background:#f0ebfb;
  flex-shrink:0;
  display:flex;
  align-items:center;
  justify-content:center
}
.workout-symbol .icon{
  width:20px;
  height:20px
}
.symbol-green{
  background:#edf4ef
}
.symbol-peach{
  background:#fff1e8
}
.workout-info{
  display:flex;
  flex-direction:column;
  min-width:0;
  flex:1
}
.workout-row-title{
  font-size:12px;
  font-weight:600;
  color:#514b62;
  text-overflow:ellipsis;
  overflow:hidden;
  white-space:nowrap
}
.workout-row-sub{
  font-size:9px;
  color:#a6a0b2;
  margin-top:4px
}
.workout-row-meta{
  font-size:11px;
  color:#686177;
  display:flex;
  align-items:center;
  gap:10px;
  white-space:nowrap
}
.meta-unit{
  font-size:9px;
  color:#aaa2b8
}
.row-chevron{
  color:#c7bfda;
  font-size:21px;
  font-weight:300;
  line-height:1
}
.volume-card{
  padding:23px;
  border-radius:17px;
  background:#eee9fa;
  border:1px solid #e8e1f5;
  position:relative;
  overflow:hidden
}
.volume-card-header{
  display:flex;
  align-items:center;
  justify-content:space-between
}
.volume-card-eyebrow{
  display:block;
  color:#b29acd;
  font-size:8px;
  letter-spacing:1.6px;
  font-weight:600
}
.volume-card-title{
  display:block;
  font-size:16px;
  font-weight:650;
  color:#6b548f;
  margin-top:5px
}
.chart-badge{
  width:35px;
  height:35px;
  border-radius:11px;
  background:#e5dcf5;
  display:flex;
  align-items:center;
  justify-content:center
}
.chart-badge .icon{
  width:18px;
  height:18px
}
.volume-number{
  font-size:33px;
  font-weight:750;
  color:#69508f;
  margin-top:20px;
  line-height:1.2;
  letter-spacing:-1px
}
.volume-number text{
  font-size:12px;
  font-weight:400;
  letter-spacing:0;
  margin-left:7px;
  color:#a38bbf
}
.volume-description{
  display:block;
  color:#ae9ac7;
  font-size:9px;
  margin-top:7px
}
.bar-chart{
  height:130px;
  display:flex;
  position:relative;
  gap:14px;
  margin-top:22px
}
.bar-grid{
  position:absolute;
  left:0;
  right:0;
  top:0;
  height:107px;
  display:flex;
  flex-direction:column;
  justify-content:space-between
}
.bar-grid view{
  height:1px;
  background:#e5ddf2
}
.chart-column{
  display:flex;
  flex-direction:column;
  align-items:center;
  flex:1;
  z-index:1;
  min-width:0
}
.chart-bar-track{
  height:107px;
  display:flex;
  align-items:flex-end;
  width:100%;
  max-width:26px
}
.chart-bar{
  width:100%;
  background:#cfc0e9;
  border-radius:5px 5px 2px 2px;
  min-height:3px
}
.bar-current{
  background:linear-gradient(#a48acf,#987ac5);
  box-shadow:0 -3px 8px #9f83c920
}
.chart-label{
  font-size:8px;
  color:#b7a6cd;
  margin-top:8px;
  white-space:nowrap
}
.volume-card-footer{
  display:flex;
  align-items:center;
  gap:6px;
  color:#ab96c4;
  font-size:8px;
  margin-top:16px;
  padding-top:13px;
  border-top:1px solid #e3daf1
}
.chart-legend-dot{
  height:5px;
  width:5px;
  background:#ab90d1;
  border-radius:2px
}
.chart-unit{
  margin-left:auto
}
.tip-card{
  padding:20px 23px;
  border:1px solid #e7e6ef;
  border-radius:16px;
  background:#f4f3f8
}
.tip-icon{
  font-size:19px;
  color:#b7a7d2;
  margin-bottom:12px
}
.tip-title{
  display:block;
  font-size:13px;
  font-weight:600;
  color:#756a8b
}
.tip-content{
  display:block;
  font-size:10px;
  line-height:1.9;
  color:#a69bb5;
  margin-top:7px;
  white-space:pre-line
}
.app-shell .tip-card .text-button{
  margin-top:17px
}
.page-footer{
  display:none
}
.bottom-nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  z-index:20;
  background:#fffffff5;
  border-top:1px solid #efebf5;
  display:flex;
  justify-content:space-around;
  padding:9px 12px 20px;
  backdrop-filter:blur(15px);
  box-shadow:0 -4px 24px #3d285008
}
.app-shell .bottom-nav-item{
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  gap:4px;
  min-width:60px;
  color:#aaa2b7;
  font-size:9px;
  border-radius:11px;
  padding:5px 12px
}
.app-shell .bottom-nav-item .icon{
  width:20px;
  height:20px;
  opacity:.68
}
.app-shell .bottom-active{
  background:#f1edfc;
  color:#8260ce
}
.app-shell .bottom-active .icon{
  opacity:1
}
.empty-state{
  padding:33px 10px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:13px;
  text-align:center;
  color:#9f96af;
  font-size:12px
}
.empty-icon{
  width:35px;
  height:35px;
  opacity:.5
}
.empty-sub{
  font-size:10px;
  color:#b0a7be
}
.app-shell .small-primary-button,.app-shell .primary-button{
  background:#7c5ce7;
  color:#fff;
  border-radius:10px;
  padding:11px 15px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:14px;
  font-size:12px;
  font-weight:550
}
.app-shell .small-primary-button{
  font-size:10px;
  padding:10px 12px;
  white-space:nowrap
}
.history-grid,.insight-grid{
  display:flex;
  flex-direction:column;
  gap:18px
}
.calendar-weekdays{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  color:#aea6bf;
  font-size:10px;
  text-align:center;
  margin-bottom:12px
}
.calendar-grid{
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
  gap:6px
}
.app-shell .calendar-day{
  height:39px;
  border-radius:9px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:3px;
  font-size:12px;
  color:#7e738f;
  border:1px solid transparent
}
.app-shell .calendar-empty{
  visibility:hidden
}
.app-shell .calendar-today{
  border-color:#ccbced;
  color:#8c6ec5
}
.app-shell .calendar-selected{
  background:#7c5ce7;
  color:#fff;
  border-color:#7c5ce7
}
.calendar-dot{
  width:4px;
  height:4px;
  border-radius:50%;
  background:#b298dc
}
.app-shell .calendar-selected .calendar-dot{
  background:#fff
}
.calendar-legend{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  font-size:9px;
  color:#b0a5bc;
  margin-top:18px;
  border-top:1px solid #f1edf7;
  padding-top:15px
}
.calendar-legend-today{
  width:9px;
  height:9px;
  border-radius:3px;
  border:1px solid #c7b3e4;
  margin-left:12px
}
.month-controls{
  display:flex;
  gap:6px
}
.app-shell .month-controls button{
  width:27px;
  height:27px;
  background:#f6f3fb;
  border-radius:7px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#9d8ab8;
  font-size:20px
}
.metric-pill{
  font-size:9px;
  color:#9e87bb;
  background:#f3eef9;
  border-radius:6px;
  padding:6px 9px;
  white-space:nowrap
}
.trend-bars{
  display:flex;
  gap:10px;
  align-items:flex-end;
  margin-top:30px
}
.trend-bar-column{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  min-width:0
}
.trend-bar-value{
  font-size:8px;
  color:#a793bc;
  margin-bottom:8px;
  white-space:nowrap
}
.trend-bar-track{
  display:flex;
  align-items:flex-end;
  width:70%;
  height:160px;
  background:repeating-linear-gradient(to top,transparent 0,transparent 39px,#f3f0f7 39px,#f3f0f7 40px)
}
.trend-bar{
  width:100%;
  background:#ded3f2;
  border-radius:6px 6px 2px 2px;
  min-height:2px
}
.trend-bar-current{
  background:linear-gradient(#ae92d9,#8a65bf)
}
.trend-bar-label{
  font-size:8px;
  color:#b0a1be;
  margin-top:11px;
  white-space:nowrap
}
.heatmap{
  display:grid;
  grid-auto-flow:column;
  grid-template-rows:repeat(7,1fr);
  grid-template-columns:repeat(12,1fr);
  gap:5px;
  margin-top:24px
}
.heat-cell{
  aspect-ratio:1;
  border-radius:3px;
  background:#f1edf7;
  min-width:0;
  min-height:10px
}
.heat-1{
  background:#d9cbec
}
.heat-2{
  background:#b69bd7
}
.heat-3{
  background:#9670c0
