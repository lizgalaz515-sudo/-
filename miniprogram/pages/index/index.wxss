/* Native phone layout: constrain the content itself, rather than clipping it. */
.app-shell,
.workspace,
.page-content,
.main-column,
.side-column,
.dashboard-grid,
.history-grid,
.insight-grid,
.recording-section,
.exercise-card,
.exercise-sheet-content,
.exercise-editor-content,
.detail-content,
.import-content,
.start-sheet-content {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
}
.app-shell {
  width: 100%;
}
.workspace {
  width: 100%;
}
.topbar,
.greeting-row,
.section-header,
.active-header,
.exercise-head,
.sheet-header,
.detail-title-row,
.rest-card,
.finish-row {
  min-width: 0;
}
.greeting-row > view:first-child,
.section-header > view:first-child,
.active-header > view:first-child,
.sheet-header > view:first-child,
.exercise-name-block,
.exercise-title-row,
.exercise-option > view:nth-child(2),
.privacy-note > view,
.recovery-banner > view {
  min-width: 0;
  flex: 1;
}
.section-title,
.section-subtitle,
.sheet-title,
.sheet-subtitle,
.exercise-name,
.previous-label,
.settings-row-sub,
.detail-note,
.editor-error,
.recovery-title,
.recovery-sub {
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}
.exercise-sheet-content,
.exercise-editor-content,
.detail-content {
  display: block;
  width: 100%;
  box-sizing: border-box;
}
.modal-backdrop {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}
.modal-sheet {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding-bottom: 30px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
}
/* Fixed-size controls must never acquire the native 184px default width. */
.app-shell .close-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 30px;
  width: 30px;
  min-width: 30px;
  max-width: 30px;
  height: 30px;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  font-size: 22px;
  line-height: 1;
  white-space: nowrap;
}
.month-controls {
  flex: 0 0 auto;
  min-width: 0;
}
.month-controls .ui-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 30px;
  width: 30px;
  min-width: 30px;
  max-width: 30px;
  height: 30px;
  margin: 0;
  padding: 0;
  line-height: 1;
}
.app-shell .set-check {
  flex: 0 0 30px;
  width: 30px;
  min-width: 30px;
  max-width: 30px;
  height: 30px;
  margin: 0;
  padding: 0;
  line-height: 1;
}
.set-remove-col {
  width: 26px;
  flex: 0 0 26px;
}
.app-shell .remove-set {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  min-width: 26px;
  max-width: 26px;
  height: 30px;
  margin: 0;
  padding: 0;
  font-size: 20px;
  line-height: 1;
}
.app-shell .week-day,
.app-shell .calendar-day,
.app-shell .muscle-option {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}
.muscle-filter {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-width: 0;
  gap: 7px;
}
.app-shell .filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 7px 11px;
  line-height: 1.5;
  white-space: nowrap;
}
.app-shell .exercise-option {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}
.exercise-option-add {
  flex: 0 0 auto;
  white-space: nowrap;
}
/* Mobile rest controls use two deliberate rows, with no squeezed controls. */
.rest-card {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  width: 100%;
  gap: 10px 8px;
  padding: 14px 12px;
}
.rest-main {
  flex: 1 1 100px;
  min-width: 100px;
  max-width: 100%;
}
.rest-presets {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  order: 4;
  flex: 0 0 100%;
  width: 100%;
  min-width: 0;
  gap: 8px;
}
.app-shell .rest-preset {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48px;
  width: 48px;
  min-width: 48px;
  max-width: 48px;
  height: 30px;
  margin: 0;
  padding: 0;
  border-radius: 6px;
  font-size: 11px;
  line-height: 1;
  white-space: nowrap;
}
.app-shell .rest-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54px;
  width: 54px;
  min-width: 54px;
  max-width: 54px;
  height: 34px;
  margin: 0;
  padding: 0;
  font-size: 12px;
  line-height: 1;
  white-space: nowrap;
}
.app-shell .rest-reset {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 30px;
  width: 30px;
  min-width: 30px;
  max-width: 30px;
  height: 34px;
  margin: 0;
  padding: 0;
  font-size: 22px;
  line-height: 1;
}
.finish-row {
  flex-wrap: wrap;
}
.finish-row > text {
  min-width: 0;
  overflow-wrap: break-word;
}
.app-shell .finish-button,
.app-shell .small-primary-button,
.app-shell .text-button {
  flex: 0 0 auto;
  max-width: 100%;
}
.settings-row > view:nth-child(2) {
  min-width: 0;
  flex: 1;
}

.record-summary > view {
  min-width: 0;
}
.settings-row .settings-row-icon,
.profile-avatar,
.muscle-option-icon {
  flex-shrink: 0;
}
.profile-card > view:nth-child(2) {
  min-width: 0;
  flex: 1;
}
/* Custom movement creation and renaming share the native sheet layout. */
.app-shell .custom-exercise-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  margin: 0 0 14px;
  padding: 13px 12px;
  border: 1px dashed #d9c7ee;
  border-radius: 10px;
  background: #fbf8ff;
  color: #8860a4;
  font-size: 13px;
  line-height: 1.5;
}
.exercise-editor-content {
  height: 56vh;
  max-height: 60vh;
  padding-bottom: 4px;
}
.editor-field,
.editor-group {
  display: block;
  width: 100%;
  min-width: 0;
  margin-bottom: 20px;
}
.editor-label {
  display: block;
  margin-bottom: 9px;
  color: #856895;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.5;
}
.editor-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 46px;
  margin: 0;
  padding: 0 13px;
  border: 1px solid #e6dcf1;
  border-radius: 9px;
  background: #fcfaff;
  color: #70517f;
  font-size: 16px;
  line-height: 1.5;
}
.editor-chips,
.editor-kind-buttons {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  width: 100%;
  min-width: 0;
  gap: 8px;
}
.app-shell .editor-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  min-width: 44px;
  max-width: 100%;
  margin: 0;
  padding: 9px 13px;
  border: 1px solid #e9e0f4;
  border-radius: 8px;
  background: #fcf9ff;
  color: #a58bb7;
  font-size: 12px;
  line-height: 1.5;
  white-space: normal;
}
.app-shell .editor-selected {
  border-color: #bea5de;
  background: #eee5fa;
  color: #8159a0;
}
.editor-kind-buttons .editor-chip {
  flex: 1 1 0;
  min-width: 0;
}

.editor-chips {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.editor-chips .editor-chip {
  width: 100%;
  min-width: 0;
}

.editor-kind-note {
  display: block;
  color: #9d86ac;
  font-size: 12px;
  line-height: 1.8;
}
.editor-error {
  display: block;
  color: #bf7684;
  font-size: 12px;
  line-height: 1.7;
  margin: 10px 0 16px;
}
.exercise-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
}
.exercise-title-row .exercise-name {
  min-width: 0;
  flex: 1;
}
.app-shell .rename-exercise {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  min-width: 44px;
  max-width: 100%;
  margin: 0;
  padding: 4px 7px;
  border-radius: 5px;
  background: #f5eefa;
  color: #9d7bb2;
  font-size: 11px;
  line-height: 1.5;
  white-space: nowrap;
}
@media (max-width: 899px) {
  .workspace {
    width: 100%;
    min-width: 0;
    padding-bottom: 104px;
    padding-bottom: calc(84px + env(safe-area-inset-bottom));
  }
  .bottom-nav {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding-bottom: 20px;
    padding-bottom: calc(12px + env(safe-area-inset-bottom));
  }
  .app-shell .bottom-nav-item {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    max-width: 100%;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
  }
  .stat-value,
  .record-value,
  .volume-number {
    max-width: 100%;
    white-space: normal;
    word-break: break-all;
    overflow-wrap: anywhere;
  }
}
@media (min-width: 600px) {
  .modal-sheet {
    width: 480px;
    max-width: calc(100% - 40px);
    padding-bottom: 27px;
  }
}
@media (min-width: 900px) {
  .workspace {
    width: calc(100% - 205px);
  }
  .rest-main {
    flex: 1 1 100px;
  }
  .rest-presets {
    order: 0;
    flex: 0 0 auto;
    width: auto;
  }
}
@media (min-width: 1200px) {
  .workspace {
    width: calc(100% - 225px);
  }
}

.nickname-card {
  margin-top: 18px;
  margin-bottom: 18px;
  padding-top: 6px;
  padding-bottom: 6px;
}
.app-shell .nickname-settings-row {
  padding-top: 15px;
  padding-bottom: 15px;
  border-bottom: 0;
}
.nickname-editor-content {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding-bottom: 4px;
}
.nickname-hint {
  display: block;
  margin-top: 10px;
  color: #a184b2;
  font-size: 12px;
  line-height: 1.8;
}
.greeting-row .eyebrow,
.profile-card .section-title,
.nickname-settings-row .settings-row-sub {
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

/* Drop sets: one completed group can contain several uninterrupted stages. */
.set-group {
  box-sizing: border-box;
  position: relative;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  border-bottom: 1px solid #f2edf8;
}

.set-group.is-drop-set {
  background: #fcfaff;
  box-shadow: inset 3px 0 0 #d7c5ee;
}

.set-group.is-drop-set::before {
  content: "";
  position: absolute;
  z-index: 1;
  left: 0;
  top: 8px;
  bottom: 8px;
  width: 2px;
  border-radius: 2px;
  background: #d7c5ee;
  pointer-events: none;
}

.drop-stage-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  gap: 8px;
  padding: 7px 11px;
  background: #fcfaff;
}

.drop-stage-label {
  display: block;
  flex: 0 0 20px;
  width: 20px;
  min-width: 20px;
  max-width: 20px;
  color: #ac8fc3;
  font-size: 10px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.2px;
  text-align: center;
  white-space: nowrap;
}

.drop-stage-row .set-input {
  background: #f1eaf9;
  color: #866197;
}

.drop-stage-row .set-done-col {
  color: #c2add7;
}

.drop-stage-link {
  display: block;
  font-size: 13px;
  line-height: 1;
}

.app-shell .remove-drop-stage {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 26px;
  width: 26px;
  min-width: 26px;
  max-width: 26px;
  height: 30px;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #c3afd0;
  font-size: 20px;
  line-height: 1;
}

.set-group-footer {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  gap: 6px 8px;
  padding: 0 11px 9px 39px;
}

.drop-set-info {
  display: inline-block;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 100%;
  padding: 4px 6px;
  border-radius: 5px;
  background: #f0e7f8;
  color: #a27db8;
  font-size: 10px;
  line-height: 1.5;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

.app-shell .add-drop-stage {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: 100%;
  min-height: 30px;
  margin: 0 0 0 auto;
  padding: 5px 9px;
  border: 1px solid #e8dcf4;
  border-radius: 6px;
  background: #f8f3fd;
  color: #9871b2;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.5;
  text-align: center;
  white-space: nowrap;
}

.drop-set-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 0;
  max-width: 100%;
  padding: 3px 6px;
  border: 1px solid #e5d7f1;
  border-radius: 5px;
  background: #f2eafa;
  color: #a07bb5;
  font-size: 9px;
  line-height: 1.4;
  white-space: nowrap;
}

.detail-drop-summary {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
  max-width: 100%;
  color: #91729f;
  font-size: 11px;
  line-height: 1.8;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
  gap: 5px;
}

.detail-set-group {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.detail-drop-stages {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 2px 13px 10px 42px;
  background: #fcf9ff;
  box-shadow: inset 2px 0 0 #dbc8ed;
}

.detail-drop-stage {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  min-width: 0;
  max-width: 100%;
  gap: 4px 12px;
  padding-top: 7px;
  color: #a185b2;
  font-size: 11px;
  line-height: 1.6;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

.detail-drop-stage > text {
  min-width: 0;
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

@media (max-width: 599px) {
  .drop-stage-row {
    padding-top: 8px;
    padding-bottom: 8px;
  }

  .drop-set-info {
    font-size: 10px;
  }

  .app-shell .add-drop-stage {
    font-size: 11px;
  }

  .detail-drop-summary,
  .detail-drop-stage {
    font-size: 12px;
  }

  .drop-set-badge {
    font-size: 10px;
  }
}

@media (min-width: 600px) {
  .drop-stage-row {
    gap: 15px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .drop-stage-label {
    flex-basis: 35px;
    width: 35px;
    min-width: 35px;
    max-width: 35px;
    font-size: 11px;
  }

  .set-group-footer {
    padding-left: 70px;
    padding-right: 20px;
  }
}
