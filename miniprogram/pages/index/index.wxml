<view class="app-shell">
  <view class="sidebar">
    <view class="brand"><view class="brand-mark"><image src="/assets/icons/dumbbell-white.svg" class="brand-icon" /></view><view><text class="brand-name">练记</text><text class="brand-en">LIFTLOG</text></view></view>
    <view class="sidebar-nav">
      <button size="mini" class="ui-button nav-item {{tab === 'today' ? 'nav-active' : ''}}" data-tab="today" bindtap="switchTab"><image src="/assets/icons/home.svg" class="icon" /><text>训练概览</text><view wx:if="{{tab === 'today'}}" class="nav-dot"></view></button>
      <button size="mini" class="ui-button nav-item {{tab === 'history' ? 'nav-active' : ''}}" data-tab="history" bindtap="switchTab"><image src="/assets/icons/calendar.svg" class="icon" /><text>训练日历</text><view wx:if="{{tab === 'history'}}" class="nav-dot"></view></button>
      <button size="mini" class="ui-button nav-item {{tab === 'insights' ? 'nav-active' : ''}}" data-tab="insights" bindtap="switchTab"><image src="/assets/icons/chart.svg" class="icon" /><text>进步趋势</text><view wx:if="{{tab === 'insights'}}" class="nav-dot"></view></button>
      <button size="mini" class="ui-button nav-item {{tab === 'settings' ? 'nav-active' : ''}}" data-tab="settings" bindtap="switchTab"><image src="/assets/icons/settings.svg" class="icon" /><text>我的记录</text><view wx:if="{{tab === 'settings'}}" class="nav-dot"></view></button>
    </view>
    <view class="sidebar-note"><view class="note-quote">“</view><text>比昨天的自己，
再进步一点。</text><view class="note-divider"></view><text class="note-small">记录每一次认真</text></view>
    <view class="sidebar-footer"><view class="save-dot"></view><text>数据保存在本机</text><image src="/assets/icons/lock.svg" class="tiny-icon" /></view>
  </view>

  <view class="workspace">
    <view class="topbar">
      <view class="mobile-brand"><view class="brand-mark"><image src="/assets/icons/dumbbell-white.svg" class="brand-icon" /></view><text>练记</text></view>
      <view class="desktop-heading"><text class="page-heading">{{tab === 'today' ? '训练概览' : tab === 'history' ? '训练日历' : tab === 'insights' ? '进步趋势' : '我的记录'}}</text><text class="heading-sub">让每一份努力，都有迹可循</text></view>
      <view class="topbar-right"><view wx:if="{{demo}}" class="demo-pill"><view class="demo-dot"></view>示例数据</view><view wx:else class="local-pill"><view class="save-dot"></view>本机保存</view><view class="avatar"><image src="/assets/icons/user.svg" class="icon" /></view></view>
    </view>

    <view wx:if="{{storageReadFailed}}" class="recovery-banner"><view><text class="recovery-title">本机记录暂时无法读取，已暂停写入。</text><text class="recovery-sub">原记录保持不变，请重试读取后再继续训练。</text></view><button size="mini" class="ui-button text-button" bindtap="retryStorageRead">重试读取 →</button></view>
    <view wx:if="{{recoveryWarning}}" class="recovery-banner"><view><text class="recovery-title">检测到无法读取的旧记录，原始数据已保留。</text><text class="recovery-sub">当前显示示例内容，请先导出旧记录，再开始新的训练。</text></view><button size="mini" class="ui-button text-button" bindtap="exportRecovery">导出原始备份 →</button></view>
    <view wx:if="{{tab === 'today'}}" class="page-content">
      <view class="greeting-row"><view><text class="eyebrow">{{dateLabel}} · {{greeting}}</text><text class="greeting-title">今天，也要好好练。</text></view><view class="small-streak"><image src="/assets/icons/flame.svg" class="icon" /><text>本周 {{summary.weekWorkouts}} 次</text></view></view>

      <view wx:if="{{!active}}" class="hero-card">
        <view class="hero-copy"><view class="hero-kicker"><view class="hero-kicker-line"></view><text>YOUR OWN PACE</text></view><text class="hero-title">每一次进步，
都值得记录。</text><text class="hero-sub">从第一组开始，练成更好的自己。</text><button size="mini" class="ui-button hero-button" bindtap="openStart"><image src="/assets/icons/plus-white.svg" class="icon" /><text>开始今天的训练</text><text class="button-arrow">↗</text></button></view>
        <view class="hero-art"><view class="art-orbit orbit-one"></view><view class="art-orbit orbit-two"></view><view class="art-star star-one">✦</view><view class="art-star star-two">✧</view><view class="dumbbell"><view class="dumbbell-bar"></view><view class="weight weight-left-outer"></view><view class="weight weight-left-inner"></view><view class="weight weight-right-inner"></view><view class="weight weight-right-outer"></view></view><view class="art-caption"><view class="save-dot"></view><text>STRONGER EVERY DAY</text></view></view>
      </view>

      <view wx:if="{{active}}" class="recording-section">
        <view class="active-header"><view><view class="recording-badge"><view class="live-dot"></view>正在训练</view><text class="section-title active-title">{{active.title}}</text><picker mode="date" value="{{active.date}}" end="{{todayDate}}" bindchange="changeWorkoutDate"><view class="date-picker-label"><image src="/assets/icons/calendar.svg" class="tiny-icon" /><text>{{active.dateLabel}}</text><text>⌄</text></view></picker></view><button size="mini" class="ui-button text-button danger-text" bindtap="discardWorkout">放弃本次</button></view>
        <view class="record-summary"><view><text class="record-value">{{active.exerciseCount}}</text><text>个动作</text></view><view><text class="record-value">{{active.setCount}}</text><text>组已完成</text></view><view><text class="record-value">{{active.volumeLabel}}</text><text>kg 训练量</text></view></view>
        <view class="exercise-card" wx:for="{{active.exercises}}" wx:for-item="exercise" wx:key="id">
          <view class="exercise-head"><view class="exercise-number">{{index + 1}}</view><view class="exercise-name-block"><view class="exercise-title-row"><text class="exercise-name">{{exercise.name}}</text><button size="mini" class="ui-button rename-exercise" data-exercise="{{exercise.id}}" bindtap="startRenameExercise" aria-label="修改{{exercise.name}}的名称">改名</button></view><text class="previous-label">{{exercise.previousLabel}}</text></view><view class="muscle-tag">{{exercise.muscle}}</view></view>
          <view class="set-table-head"><text class="set-index-col">组</text><text class="set-weight-col">{{exercise.kind === 'bodyweight' ? '自重 / kg' : '重量 / kg'}}</text><text class="set-reps-col">次数</text><text class="set-done-col">完成</text><text class="set-remove-col"></text></view>
          <view class="set-row {{set.completed ? 'set-completed' : ''}}" wx:for="{{exercise.sets}}" wx:for-item="set" wx:for-index="setIndex" wx:key="id">
            <text class="set-index-col set-number">{{setIndex + 1}}</text><view class="set-weight-col"><input class="set-input" type="digit" value="{{set.weight}}" data-exercise="{{exercise.id}}" data-set="{{set.id}}" data-field="weight" bindinput="changeSet" bindblur="normalizeSet" disabled="{{exercise.kind === 'bodyweight'}}" aria-label="{{exercise.name}} 第{{setIndex + 1}}组重量" /></view><view class="set-reps-col"><input class="set-input" type="number" value="{{set.reps}}" data-exercise="{{exercise.id}}" data-set="{{set.id}}" data-field="reps" bindinput="changeSet" bindblur="normalizeSet" aria-label="{{exercise.name}} 第{{setIndex + 1}}组次数" /></view><view class="set-done-col"><button size="mini" class="ui-button set-check {{set.completed ? 'checked' : ''}}" data-exercise="{{exercise.id}}" data-set="{{set.id}}" bindtap="toggleSet" aria-label="{{set.completed ? '取消完成' : '完成这一组'}}"><image src="/assets/icons/check-white.svg" wx:if="{{set.completed}}" class="tiny-icon" /></button></view><view class="set-remove-col"><button size="mini" class="ui-button remove-set" data-exercise="{{exercise.id}}" data-set="{{set.id}}" bindtap="removeSet" aria-label="删除这一组">×</button></view>
          </view>
          <button size="mini" class="ui-button add-set-button" data-exercise="{{exercise.id}}" bindtap="addSet"><text>＋</text> 沿用上一组</button>
        </view>
        <button size="mini" class="ui-button add-exercise-button" bindtap="openExercisePicker"><image src="/assets/icons/plus.svg" class="icon" />添加训练动作</button>
        <view class="rest-card"><view class="rest-main"><image src="/assets/icons/clock.svg" class="icon" /><view><text class="rest-title">组间休息</text><text class="rest-time">{{restLabel}}</text></view></view><view class="rest-presets"><button size="mini" wx:for="{{[60,90,120]}}" wx:key="*this" class="ui-button rest-preset {{restSeconds === item ? 'rest-selected' : ''}}" data-seconds="{{item}}" bindtap="setRest">{{item}}s</button></view><button size="mini" class="ui-button rest-toggle" bindtap="toggleRest">{{restRunning ? '暂停' : '开始'}}</button><button size="mini" class="ui-button rest-reset" bindtap="resetRest" aria-label="重置计时">↺</button></view>
        <textarea class="workout-notes" placeholder="记下今天的状态、动作感受…（选填）" value="{{active.notes}}" bindinput="updateNotes" maxlength="2000" aria-label="训练备注" />
        <view class="finish-row"><text>勾选完成的组数，随时自动保存</text><button size="mini" class="ui-button primary-button finish-button" bindtap="finishWorkout">完成训练 <text>✓</text></button></view>
      </view>

      <view class="stats-grid"><view class="stat-card"><view class="stat-top"><text>本周训练</text><view class="stat-icon stat-purple"><image src="/assets/icons/dumbbell.svg" class="icon" /></view></view><view class="stat-value">{{summary.weekWorkouts}}<text class="stat-unit">次</text></view><text class="stat-caption">每一次出发，都算数</text></view><view class="stat-card"><view class="stat-top"><text>本周训练量</text><view class="stat-icon stat-green"><image src="/assets/icons/weight.svg" class="icon" /></view></view><view class="stat-value">{{summary.weekVolume}}<text class="stat-unit">kg</text></view><text class="stat-caption">每组重量 × 次数之和</text></view><view class="stat-card"><view class="stat-top"><text>本周完成组数</text><view class="stat-icon stat-peach"><image src="/assets/icons/layers.svg" class="icon" /></view></view><view class="stat-value">{{summary.weekSets}}<text class="stat-unit">组</text></view><text class="stat-caption">把坚持，变成看得见的积累</text></view></view>

      <view class="dashboard-grid">
        <view class="main-column"><view class="content-card week-card"><view class="section-header"><view><text class="section-title">这一周的坚持</text><text class="section-subtitle">{{weekLabel}}</text></view><button size="mini" class="ui-button text-button" data-tab="history" bindtap="switchTab">查看日历 <text>↗</text></button></view><view class="week-days"><button size="mini" class="ui-button week-day {{item.isToday ? 'week-today' : ''}}" wx:for="{{weekDays}}" wx:key="date" data-date="{{item.date}}" bindtap="selectDate"><text class="week-label">{{item.label}}</text><view class="week-date {{item.done ? 'week-done' : ''}}">{{item.day}}<view wx:if="{{item.done}}" class="week-check">✓</view></view><view class="week-indicator {{item.done ? 'indicator-done' : ''}}"></view></button></view><view class="week-footer"><view class="save-dot"></view><text>不用每天完美，只需持续向前。</text></view></view>
          <view class="content-card recent-card"><view class="section-header"><view><text class="section-title">最近训练</text><text class="section-subtitle">每一条记录，都是进步的证据</text></view><button size="mini" class="ui-button text-button" data-tab="history" bindtap="switchTab">全部 <text>↗</text></button></view><view wx:if="{{!recentWorkouts.length}}" class="empty-state"><image src="/assets/icons/dumbbell.svg" class="empty-icon" /><text>第一条记录，就从今天开始</text><button size="mini" class="ui-button text-button" bindtap="openStart">开始训练 →</button></view><button size="mini" wx:for="{{recentWorkouts}}" wx:key="id" class="ui-button workout-row" data-id="{{item.id}}" bindtap="showWorkout"><view class="workout-symbol {{index % 3 === 1 ? 'symbol-green' : index % 3 === 2 ? 'symbol-peach' : ''}}"><image src="/assets/icons/dumbbell.svg" class="icon" /></view><view class="workout-info"><text class="workout-row-title">{{item.title}}</text><text class="workout-row-sub">{{item.dateLabel}} · {{item.exerciseCount}} 个动作 · {{item.setCount}} 组</text></view><view class="workout-row-meta"><text>{{item.volumeLabel}} <text class="meta-unit">kg</text></text><text class="row-chevron">›</text></view></button></view>
        </view>
        <view class="side-column"><view class="volume-card"><view class="volume-card-header"><view><text class="volume-card-eyebrow">YOUR PROGRESS</text><text class="volume-card-title">努力，有迹可循</text></view><view class="chart-badge"><image src="/assets/icons/chart.svg" class="icon" /></view></view><view class="volume-number">{{summary.totalVolume}}<text>kg</text></view><text class="volume-description">累计训练量 · 最近 7 周趋势</text><view class="bar-chart"><view class="bar-grid"><view></view><view></view><view></view></view><view class="chart-column" wx:for="{{bars}}" wx:key="label"><view class="chart-bar-track"><view class="chart-bar {{item.isCurrent ? 'bar-current' : ''}}" style="height: {{item.height}}%;"></view></view><text class="chart-label">{{item.label}}</text></view></view><view class="volume-card-footer"><view class="chart-legend-dot"></view><text>每周完成训练量</text><text class="chart-unit">kg</text></view></view><view class="tip-card"><view class="tip-icon">✦</view><text class="tip-title">你只需要，和自己比较。</text><text class="tip-content">重量多一点，动作稳一点，
每一个微小进步都值得被看见。</text><button size="mini" class="ui-button text-button" data-tab="insights" bindtap="switchTab">看看我的进步 <text>→</text></button></view></view>
      </view>
    </view>

    <view wx:elif="{{tab === 'history'}}" class="page-content">
      <view class="greeting-row"><view><text class="eyebrow">TRAINING JOURNAL</text><text class="greeting-title">把坚持，写进日历。</text></view><button size="mini" class="ui-button small-primary-button" bindtap="openStart">＋ 记一笔</button></view>
      <view class="history-grid"><view class="content-card calendar-card"><view class="section-header"><text class="section-title">{{calendarLabel}}</text><view class="month-controls"><button class="ui-button" size="mini" bindtap="previousMonth" aria-label="上个月">‹</button><button class="ui-button" size="mini" bindtap="nextMonth" aria-label="下个月">›</button></view></view><view class="calendar-weekdays"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><button size="mini" wx:for="{{calendar}}" wx:key="date" class="ui-button calendar-day {{item.empty ? 'calendar-empty' : ''}} {{item.selected ? 'calendar-selected' : ''}} {{item.isToday ? 'calendar-today' : ''}}" data-date="{{item.date}}" bindtap="selectDate" disabled="{{item.empty}}"><text>{{item.day}}</text><view wx:if="{{item.count}}" class="calendar-dot"></view></button></view><view class="calendar-legend"><view class="calendar-dot"></view><text>有训练记录</text><view class="calendar-legend-today"></view><text>今天</text></view></view><view class="content-card history-list"><view class="section-header"><view><text class="section-title">{{selectedDate}}</text><text class="section-subtitle">{{historyWorkouts.length}} 次训练记录</text></view><image src="/assets/icons/calendar.svg" class="icon" /></view><view class="empty-state" wx:if="{{!historyWorkouts.length}}"><image src="/assets/icons/calendar.svg" class="empty-icon" /><text>这一天还没有训练记录</text><text class="empty-sub">休息，也是训练的一部分。</text></view><button size="mini" class="ui-button workout-row" wx:for="{{historyWorkouts}}" wx:key="id" data-id="{{item.id}}" bindtap="showWorkout"><view class="workout-symbol"><image src="/assets/icons/dumbbell.svg" class="icon" /></view><view class="workout-info"><text class="workout-row-title">{{item.title}}</text><text class="workout-row-sub">{{item.exerciseCount}} 个动作 · {{item.setCount}} 组</text></view><view class="workout-row-meta"><text>{{item.volumeLabel}} <text class="meta-unit">kg</text></text><text class="row-chevron">›</text></view></button></view></view>
    </view>

    <view wx:elif="{{tab === 'insights'}}" class="page-content">
      <view class="greeting-row"><view><text class="eyebrow">A LITTLE STRONGER</text><text class="greeting-title">你的努力，看得见。</text></view><view class="local-pill">累计 {{summary.totalWorkouts}} 次训练</view></view>
      <view class="stats-grid"><view class="stat-card"><text class="stat-label">累计训练</text><view class="stat-value">{{summary.totalWorkouts}}<text class="stat-unit">次</text></view><text class="stat-caption">从第一次，到每一次</text></view><view class="stat-card"><text class="stat-label">累计训练量</text><view class="stat-value">{{summary.totalVolume}}<text class="stat-unit">kg</text></view><text class="stat-caption">仅统计已完成的负重训练</text></view><view class="stat-card"><text class="stat-label">累计完成</text><view class="stat-value">{{summary.totalSets}}<text class="stat-unit">组</text></view><text class="stat-caption">自重训练也计入组数</text></view></view>
      <view class="content-card trend-card"><view class="section-header"><view><text class="section-title">训练量趋势</text><text class="section-subtitle">最近 7 周 · 重量 × 次数，仅统计完成组</text></view><view class="metric-pill">每周 / kg</view></view><view class="trend-bars"><view class="trend-bar-column" wx:for="{{bars}}" wx:key="label"><text class="trend-bar-value">{{item.volumeLabel}}</text><view class="trend-bar-track"><view class="trend-bar {{item.isCurrent ? 'trend-bar-current' : ''}}" style="height: {{item.height}}%;"></view></view><text class="trend-bar-label">{{item.label}}</text></view></view></view>
      <view class="insight-grid"><view class="content-card heatmap-card"><view class="section-header"><view><text class="section-title">坚持的痕迹</text><text class="section-subtitle">最近 12 周的训练频率</text></view><image src="/assets/icons/flame.svg" class="icon" /></view><view class="heatmap"><view wx:for="{{heatmap}}" wx:key="date" class="heat-cell heat-{{item.level}}" aria-label="{{item.date}} {{item.count}}次训练"></view></view><view class="heatmap-legend"><text>每个方格代表一天</text><view class="heatmap-scale"><text>少</text><view class="heat-cell heat-0"></view><view class="heat-cell heat-1"></view><view class="heat-cell heat-2"></view><view class="heat-cell heat-3"></view><text>多</text></view></view></view><view class="content-card muscle-card"><view class="section-header"><view><text class="section-title">训练部位分布</text><text class="section-subtitle">按已完成动作组数统计</text></view></view><view wx:for="{{muscleStats}}" wx:key="name" class="muscle-stat-row"><text>{{item.name}}</text><view class="muscle-stat-track"><view class="muscle-stat-fill" style="width: {{item.percent}}%;"></view></view><text class="muscle-stat-count">{{item.count}} 组</text></view></view></view>
    </view>

    <view wx:elif="{{tab === 'settings'}}" class="page-content settings-page">
      <view class="greeting-row"><view><text class="eyebrow">YOUR PERSONAL SPACE</text><text class="greeting-title">你的记录，由你保管。</text></view></view><view class="content-card profile-card"><view class="profile-avatar"><image src="/assets/icons/user.svg" class="large-icon" /></view><view><text class="section-title">我的训练手记</text><text class="section-subtitle">{{summary.totalWorkouts}} 次训练 · {{summary.totalSets}} 个完成组</text></view><view class="local-pill"><view class="save-dot"></view>本机保存</view></view>
      <view wx:if="{{demo}}" class="demo-banner"><view class="demo-banner-icon">✦</view><view><text class="demo-banner-title">先逛一逛，再开始你的记录</text><text class="demo-banner-text">当前为示例数据，用来展示记录和图表效果。
清空示例后，就可以建立属于你的训练日记。</text></view><button size="mini" class="ui-button small-primary-button" bindtap="clearDemo">清空示例</button></view>
      <view class="content-card data-card"><view class="section-header"><view><text class="section-title">数据与备份</text><text class="section-subtitle">定期备份，让每次进步都安心留存</text></view></view><button size="mini" class="ui-button settings-row" bindtap="exportData"><view class="settings-row-icon"><image src="/assets/icons/download.svg" class="icon" /></view><view><text class="settings-row-title">导出训练记录</text><text class="settings-row-sub">复制 JSON 备份，保存到你信任的位置</text></view><text class="row-chevron">›</text></button><button size="mini" class="ui-button settings-row" bindtap="openImport"><view class="settings-row-icon"><image src="/assets/icons/upload.svg" class="icon" /></view><view><text class="settings-row-title">恢复备份</text><text class="settings-row-sub">粘贴之前导出的 JSON 训练记录</text></view><text class="row-chevron">›</text></button></view><view class="privacy-note"><image src="/assets/icons/lock.svg" class="icon" /><view><text>关于你的数据</text><text>本版记录仅保存在当前设备，不会自动上传或跨设备同步。卸载小程序或清理微信数据可能丢失记录，请记得导出备份。</text></view></view><view class="settings-footer"><text class="footer-brand">练记 LIFTLOG</text><text>把每一次努力，练成更好的自己。</text><text class="version-text">v1.1 · 为认真训练的你而做</text></view>
    </view>

    <view class="page-footer"><text>一点一点，成为更好的自己。</text><text>LIFTLOG · 记录每一次认真</text></view>
  </view>

  <view class="bottom-nav"><button size="mini" class="ui-button bottom-nav-item {{tab === 'today' ? 'bottom-active' : ''}}" data-tab="today" bindtap="switchTab"><image src="/assets/icons/home.svg" class="icon" /><text>训练</text></button><button size="mini" class="ui-button bottom-nav-item {{tab === 'history' ? 'bottom-active' : ''}}" data-tab="history" bindtap="switchTab"><image src="/assets/icons/calendar.svg" class="icon" /><text>日历</text></button><button size="mini" class="ui-button bottom-nav-item {{tab === 'insights' ? 'bottom-active' : ''}}" data-tab="insights" bindtap="switchTab"><image src="/assets/icons/chart.svg" class="icon" /><text>趋势</text></button><button size="mini" class="ui-button bottom-nav-item {{tab === 'settings' ? 'bottom-active' : ''}}" data-tab="settings" bindtap="switchTab"><image src="/assets/icons/settings.svg" class="icon" /><text>我的</text></button></view>

  <view wx:if="{{sheet}}" class="modal-backdrop" bindtap="closeSheet"><view class="modal-sheet {{sheet === 'detail' ? 'detail-sheet' : ''}}" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-header"><view><text class="sheet-title">{{sheet === 'start' ? '开始一场好训练' : sheet === 'exercise' ? '添加训练动作' : sheet === 'customExercise' ? (editingExerciseId ? '修改训练动作' : '新建训练动作') : sheet === 'detail' ? '训练详情' : '恢复训练备份'}}</text><text class="sheet-subtitle">{{sheet === 'start' ? '选择今天要练的部位，动作和组数都可以调整' : sheet === 'exercise' ? '选择已有动作，或新建你自己的动作' : sheet === 'customExercise' ? (editingExerciseId ? '只修改本次动作，原来的重量、次数和组数都会保留' : '保存到你的动作库，下次训练可以直接选择') : sheet === 'detail' ? detail.dateLabel : '导入前请先导出当前数据，以免记录丢失'}}</text></view><button size="mini" class="ui-button close-button" bindtap="closeSheet" aria-label="关闭">×</button></view>
    <view wx:if="{{sheet === 'start'}}" class="start-sheet-content"><view class="muscle-options"><button size="mini" wx:for="{{muscles}}" wx:key="*this" class="ui-button muscle-option {{selectedMuscle === item ? 'muscle-selected' : ''}}" data-muscle="{{item}}" bindtap="selectMuscle"><view class="muscle-option-icon"><image src="/assets/icons/dumbbell.svg" class="icon" /></view><text>{{item}}训练</text><view class="muscle-option-check">{{selectedMuscle === item ? '✓' : ''}}</view></button></view><view class="template-hint"><image src="/assets/icons/layers.svg" class="icon" /><text>自动带入常用动作和上次训练成绩，随时可调整</text></view><button size="mini" class="ui-button primary-button sheet-primary" bindtap="startWorkout">开始{{selectedMuscle}}训练 <text>→</text></button></view>
    <scroll-view wx:elif="{{sheet === 'exercise'}}" scroll-y class="exercise-sheet-content"><view class="muscle-filter"><button size="mini" wx:for="{{muscles}}" wx:key="*this" class="ui-button filter-chip {{selectedMuscle === item ? 'filter-active' : ''}}" data-muscle="{{item}}" bindtap="selectMuscle">{{item}}</button></view><button size="mini" class="ui-button custom-exercise-entry" bindtap="openCustomExercise"><image src="/assets/icons/plus.svg" class="icon" /><text>新建自定义动作</text><text class="row-chevron">›</text></button><button size="mini" class="ui-button exercise-option" wx:for="{{exerciseOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseExercise" disabled="{{item.selected}}"><view class="workout-symbol"><image src="/assets/icons/dumbbell.svg" class="icon" /></view><view><text class="exercise-name">{{item.name}}</text><text class="exercise-option-sub">{{item.muscle}} · {{item.custom ? '自定义 · ' : ''}}{{item.kind === 'bodyweight' ? '自重训练' : '负重训练'}}</text></view><text class="exercise-option-add">{{item.selected ? '已添加' : '＋'}}</text></button></scroll-view>
    <scroll-view wx:elif="{{sheet === 'customExercise'}}" scroll-y class="exercise-editor-content">
      <view class="editor-field">
        <text class="editor-label">动作名称</text>
        <input class="editor-input" type="text" value="{{editorName}}" bindinput="updateExerciseName" maxlength="60" placeholder="例如：杠铃推肩、器械侧平举" aria-label="动作名称" />
      </view>
      <view class="editor-group">
        <text class="editor-label">训练部位</text>
        <view class="editor-chips"><button size="mini" wx:for="{{muscles}}" wx:key="*this" class="ui-button editor-chip {{editorMuscle === item ? 'editor-selected' : ''}}" data-muscle="{{item}}" bindtap="selectEditorMuscle">{{item}}</button></view>
      </view>
      <view class="editor-group">
        <text class="editor-label">训练类型</text>
        <view wx:if="{{!editingExerciseId}}" class="editor-kind-buttons">
          <button size="mini" class="ui-button editor-chip {{editorKind === 'weighted' ? 'editor-selected' : ''}}" data-kind="weighted" bindtap="setExerciseKind">负重 · kg × 次数</button>
          <button size="mini" class="ui-button editor-chip {{editorKind === 'bodyweight' ? 'editor-selected' : ''}}" data-kind="bodyweight" bindtap="setExerciseKind">自重 · 记录次数</button>
        </view>
        <text wx:else class="editor-kind-note">{{editorKind === 'weighted' ? '负重训练 · 原有重量和次数保持不变' : '自重训练 · 原有次数保持不变'}}</text>
      </view>
      <text wx:if="{{editorError}}" class="editor-error" role="alert">{{editorError}}</text>
      <button size="mini" class="ui-button primary-button sheet-primary" bindtap="saveCustomExercise">{{editingExerciseId ? '保存修改' : '保存并添加动作'}}</button>
    </scroll-view>
    <scroll-view wx:elif="{{sheet === 'detail'}}" scroll-y class="detail-content"><view class="detail-title-row"><text class="detail-title">{{detail.title}}</text><view class="metric-pill">{{detail.durationMinutes}} 分钟</view></view><view class="record-summary"><view><text class="record-value">{{detail.exerciseCount}}</text><text>个动作</text></view><view><text class="record-value">{{detail.setCount}}</text><text>组已完成</text></view><view><text class="record-value">{{detail.volumeLabel}}</text><text>kg 训练量</text></view></view><view class="detail-exercise" wx:for="{{detail.exercises}}" wx:for-item="exercise" wx:key="id"><text class="exercise-name">{{exercise.name}}</text><view class="detail-sets"><view class="detail-set" wx:for="{{exercise.sets}}" wx:for-item="set" wx:for-index="setIndex" wx:key="id"><text class="detail-set-index">{{setIndex + 1}}</text><text>{{exercise.kind === 'bodyweight' ? '自重' : set.weight + ' kg'}} <text class="detail-times">×</text> {{set.reps}} 次</text><text class="detail-set-status">{{set.completed ? '✓ 完成' : '未完成'}}</text></view></view></view><view wx:if="{{detail.notes}}" class="detail-note"><text class="rest-title">训练手记</text><text>{{detail.notes}}</text></view><button size="mini" class="ui-button delete-workout-button" data-id="{{detail.id}}" bindtap="deleteWorkout"><image src="/assets/icons/trash.svg" class="icon" />删除这条记录</button></scroll-view>
    <view wx:elif="{{sheet === 'import'}}" class="import-content"><textarea class="import-textarea" placeholder="在这里粘贴之前导出的 JSON 备份…" value="{{importText}}" bindinput="updateImport" maxlength="-1" aria-label="JSON 备份内容" /><view class="import-warning">恢复备份将替换当前记录，操作前请先做好备份。</view><button size="mini" class="ui-button primary-button sheet-primary" bindtap="confirmImport">检查并恢复备份</button></view>
  </view></view>
</view>
